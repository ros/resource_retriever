<package format="3">
  <name>resource_retriever</name>
  <version>3.10.2</version>
  <description>
    This package retrieves data from url-format files such as http://, https://, package://, file://, and loads the data into memory. The package:// url for ROS packages is translated into a local file:// url. The resource retriever was initially designed to load mesh files into memory, but it can be used for any type of data. Remote urls are retrieved with the libcurl library.
  </description>

  <maintainer email="alejandro@openrobotics.org">Alejandro Hernandez Cordero</maintainer>

  <license>BSD</license>

  <author email="clalancette@osrfoundation.org">Chris Lalancette</author>
  <author email="isucan@gmail.com">Ioan Sucan</author>
  <author email="jfaust@willowgarage.com">Josh Faust</author>
  <author email="sloretz@osrfoundation.org">Shane Loretz</author>

  <url type="website">https://docs.ros.org/en/rolling/p/resource_retriever/</url>
  <url type="repository">https://github.com/ros/resource_retriever</url>
  <url type="bugtracker">https://github.com/ros/resource_retriever/issues</url>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>
  <buildtool_depend>ament_cmake_ros_core</buildtool_depend>

  <build_depend>libcurl-dev</build_depend>

  <depend>ament_index_cpp</depend>
  <depend>ament_index_python</depend>

  <exec_depend>libcurl</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rosdoc2>rosdoc2.yaml</rosdoc2>
  </export>
</package>
